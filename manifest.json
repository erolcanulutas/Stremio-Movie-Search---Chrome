{
  "manifest_version": 3,
  "name": "Stremio Movie Search",
  "version": "1.8",
  "description": "Stremio Movie Search enhances your Google, DuckDuckGo, IMDb, and Trakt.tv experience by adding a Stremio icon next to show titles.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://duckduckgo.com/*",
        "*://www.imdb.com/title/*",
        "*://trakt.tv/movies/*",
        "*://trakt.tv/shows/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "96": "icons/stremio.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/stremio.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}